# WhatsApp Cloud API Credentials
# Obtén estos valores desde Meta for Developers (https://developers.facebook.com)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=1234567890123456
# Número del bot de WhatsApp (Sandbox de Meta)
WHATSAPP_BOT_PHONE_NUMBER=+1 555-012-6859
# Número de teléfono del usuario/destinatario para pruebas (ej. con código de país 52 para México)
WHATSAPP_TEST_RECIPIENT_PHONE_NUMBER=523312345678
WHATSAPP_VERIFY_TOKEN=mi_token_secreto_de_verificacion_adk
# WHATSAPP_APP_SECRET=tu_app_secret_de_meta (Opcional, déjalo comentado a menos que quieras validar firmas HMAC)
WHATSAPP_API_VERSION=v25.0

# Google ADK API Server Configuration
ADK_API_URL=http://localhost:8000
ADK_APP_NAME=chat_assistant
